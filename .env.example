# Copie para .env e preencha só o bloco do provedor escolhido.

# Provedor do modelo: ollama | anthropic | openai | deepseek
LLM_PROVIDER=ollama
# Modelo do provedor; vazio usa o padrão: qwen3.5:9b, claude-sonnet-5-5, gpt-5.4-mini, deepseek-flash
LLM_MODEL=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- DeepSeek ---
DEEPSEEK_API_KEY=

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434

# Data tratada como "hoje" nos dados da loja (prazos de devolução, atraso de entrega).
# Os CSVs são um retrato de março/2026: ver "Fixed reference date" no README.
REFERENCE_DATE=2026-03-23

# Fuso da loja, usado para dizer se ela está aberta agora (relógio real).
STORE_TIMEZONE=America/Campo_Grande

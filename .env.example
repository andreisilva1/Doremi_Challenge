# Copie para .env e preencha só o bloco do provedor escolhido.

# Provedor do modelo: deepseek | openai | anthropic | ollama
LLM_PROVIDER=ollama
# Nome do modelo no provedor escolhido (IDs exatos documentados no README)
LLM_MODEL=

# --- DeepSeek ---
DEEPSEEK_API_KEY=

# --- OpenAI (GPT) ---
OPENAI_API_KEY=

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434

# Data tratada como "hoje" nos dados da loja (prazos de devolução, atraso de entrega).
# Os CSVs são um retrato de março/2026: ver "Suposições" no README.
REFERENCE_DATE=2026-03-23

# Fuso da loja, usado para dizer se ela está aberta agora (relógio real).
STORE_TIMEZONE=America/Campo_Grande
